{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "types": ["jasmine", "@testing-library/jasmine-dom", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
